<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EMailViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EMailViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lokales E-Mail Archiv">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Pfadauswahl ganz oben (erstreckt sich über alle 3 Spalten) -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="PfadTextBox" Header="Aktueller E-Mail-Archivordner:" VerticalAlignment="Bottom"/>
            
            <Button Click="OrdnerDurchsuchen_Click" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom" ToolTipService.ToolTip="Ordner durchsuchen">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xED25;" FontSize="14"/>
                    <TextBlock Text="Durchsuchen..."/>
                </StackPanel>
            </Button>
            
            <Button Content="Ordner laden" Click="OrdnerLaden_Click" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- LINKE SEITE: Die Liste -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Archivierte E-Mails" Margin="4,0,0,12" FontSize="18" FontWeight="Bold"/>

            <ListView x:Name="EmailListView" Grid.Row="1" SelectionChanged="EmailListView_SelectionChanged" SelectionMode="Single" ScrollViewer.CanContentRenderOutsideBounds="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EmailEintrag">
                        <StackPanel Padding="4" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Absender}" FontSize="12" FontWeight="Bold" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Datum}" FontSize="11" Foreground="Gray" Grid.Column="1"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Betreff}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- DIE TRENNLINIE -->
        <Border Grid.Row="1" Grid.Column="1" Background="LightGray" Margin="0,4"/>

        <!-- RECHTE SEITE: Die Inhaltsanzeige -->
        <Grid Grid.Row="1" Grid.Column="2" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="LightGray" Margin="12,0,0,0">
            <TextBlock x:Name="NoSelectionText" Text="Wähle eine E-Mail aus der Liste aus, um die Vorschau anzuzeigen." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="14"/>

            <!-- Der Lade-Kreisel (Perfekt zentriert platziert) -->
            <ProgressRing x:Name="LadeAnzeige" IsActive="False" Visibility="Collapsed" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Grid x:Name="EmailDetailPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="DeleteButton" 
                        Grid.Row="0" 
                        Content="E-Mail löschen" 
                        Click="EmailLoeschen_Click" 
                        Background="DarkRed" 
                        Foreground="White" 
                        HorizontalAlignment="Right" 
                        Margin="0,0,0,12"/>

                <TextBlock x:Name="DetailDatum" Grid.Row="1" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <TextBlock x:Name="DetailBetreff" Grid.Row="2" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                <MenuFlyoutSeparator Grid.Row="3" Margin="0,0,0,16"/>

                <!-- Bereich für Anhänge -->
                <StackPanel x:Name="AnhaengePanel" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="Anhänge:" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListView x:Name="AnhaengeListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="5">
                                    <FontIcon Glyph="&#xE723;" FontSize="16"/>
                                    <TextBlock Text="{Binding CustomFilename}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GroesseFormatiert}" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Content="Öffnen" Click="AnhangOeffnen_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Das Vorschaufenster -->
                <WebView2 x:Name="EmailWebView" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</Window>